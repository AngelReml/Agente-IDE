# ── Proyecto ──────────────────────────────────────────────────────────────────
PROJECT_ROOT=C:/Users/TU_USUARIO/Desktop/mi-proyecto

# ── Proveedores (añade solo los que tengas) ───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GLM_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=

# ── Servidor / seguridad (Fase 1/3) ───────────────────────────────────────────
SWARM_HOST=127.0.0.1            # loopback por defecto; 0.0.0.0 para LAN (requiere token)
SWARM_PORT=8000
SWARM_AUTH_TOKEN=               # secreto compartido; obligatorio si SWARM_HOST no es loopback
SWARM_SECRET=                   # firma de tokens JWT-like (Fase 3). Si se define, se activa auth
SWARM_CORS_ORIGINS=             # orígenes permitidos, coma-separados (def: localhost:3000)
SWARM_ALLOW_PRIVATE_FETCH=0     # 1 permite fetch_url a IPs privadas

# ── Sandbox de ejecución (Fase 1) ─────────────────────────────────────────────
SWARM_SANDBOX=local             # local | docker | auto
SWARM_SANDBOX_IMAGE=swarm-sandbox:latest
SWARM_SANDBOX_NETWORK=none      # none (sin egress) | bridge
SWARM_SANDBOX_MEMORY=1g
# Exponer el server (0.0.0.0) con SWARM_SANDBOX=local es RCE: el server se NIEGA a
# arrancar en esa combinación salvo que asumas el riesgo conscientemente:
SWARM_ALLOW_INSECURE_LOCAL_SANDBOX=0
# Confina POST /api/project/switch a este directorio (recomendado en multi-tenant):
SWARM_PROJECTS_DIR=
# Backend de búsqueda de contexto del enjambre: tfidf (def., offline) | embeddings (Fase 4):
SWARM_RETRIEVAL=tfidf

# ── Persistencia (Fase 2) ─────────────────────────────────────────────────────
SWARM_DB=sqlite                 # sqlite (local) | postgres
DATABASE_URL=                   # p.ej. postgresql+psycopg://USER:PASS@localhost:5432/swarm
REDIS_URL=                      # p.ej. redis://:PASS@localhost:6379/0  (cola/pubsub, opcional)

# Credenciales del docker-compose (OBLIGATORIAS; sin defaults débiles tipo swarm/swarm):
POSTGRES_USER=swarm
POSTGRES_PASSWORD=
POSTGRES_DB=swarm
REDIS_PASSWORD=

# ── Frontend ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SWARM_TOKEN=      # token si el backend exige auth
