# API del Swarm IDE (Fase 2/3).
FROM python:3.11-slim

WORKDIR /app

# git es necesario para las herramientas de control de versiones del agente.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-platform.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-platform.txt

COPY . .

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
